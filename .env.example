# @BotFather dan olingan token
BOT_TOKEN=BU_YERGA_TOKEN
# Admin Telegram ID (bir nechta bo'lsa vergul bilan: 111,222)
ADMIN_ID=
# Qo'shiq maksimal davomiyligi (soniya)
MAX_DURATION=900
# m4a = eng tez, mp3 = sekinroq (ffmpeg qayta kodlaydi)
AUDIO_FORMAT=m4a
# Ro'yxat chiqqanda nechta qo'shiq oldindan yuklanadi (0 = o'chirilgan)
PREFETCH_COUNT=3
# Bir vaqtda nechta Instagram video yuklanadi
VIDEO_PARALLEL=3
# VPN/proxy bo'lsa (ixtiyoriy), masalan: socks5://127.0.0.1:1080
PROXY=
